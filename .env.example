# BaseMile build options.
#
# The default map uses OpenFreeMap's dark tiles (tiles.openfreemap.org), which
# need no key and no account. Copy this file to .env.local only to use another
# tile provider. Every variable is optional. Values are read at build time, so
# restart Metro after changing them.
#
# Never commit .env.local.

# Custom raster map tiles: one https {z}/{x}/{y} URL template and the
# attribution your provider requires.
EXPO_PUBLIC_MAP_TILE_URL=
EXPO_PUBLIC_MAP_ATTRIBUTION=
